// Jobfather - Aspirant Hub
// Database: Neon PostgreSQL (serverless)
// ORM: Prisma 7.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────
// AUTH MODELS (NextAuth v5 / Auth.js)
// ────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  password           String? // hashed via bcryptjs (email/password flow)
  role               UserRole  @default(ASPIRANT)
  mockTestPlan       String?   @default("free") // "free", "3m", "6m", "12m"
  mockTestPlanExpiry DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  watchlist       ExamWatch[]
  mockTestResults MockTestResult[]
  upgradeRequests UpgradeRequest[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ────────────────────────────────────────────────
// CORE DOMAIN MODELS
// ────────────────────────────────────────────────

model Job {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  organization      String
  category          Category
  totalVacancies    Int?
  description       String?  @db.Text
  syllabusUrl       String? // Link to official syllabus PDF
  sourceUrl         String // Official notification URL
  applyUrl          String? // Direct application link
  isVerified        Boolean  @default(false)
  isPrivate         Boolean  @default(false)
  paymentScreenshot String?  @db.Text
  postedAt          DateTime @default(now())
  updatedAt         DateTime @updatedAt

  timeline ExamTimeline?
  watches  ExamWatch[]

  @@index([category])
  @@index([slug])
  @@index([postedAt(sort: Desc)])
}

model ExamTimeline {
  id    String @id @default(cuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Key milestone dates
  notificationDate DateTime?
  applicationStart DateTime?
  applicationEnd   DateTime?
  admitCardDate    DateTime?
  examDate         DateTime?
  resultDate       DateTime?

  // Current lifecycle stage (auto-derived or manually set)
  currentStage Stage    @default(NOTIFICATION)
  updatedAt    DateTime @updatedAt

  @@index([currentStage])
  @@index([applicationEnd]) // Critical for "Closing Soon" queries
  @@index([examDate])
}

model ExamWatch {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId]) // One watch per user per exam
  @@index([userId])
  @@index([jobId])
}

model Ad {
  id          String     @id @default(cuid())
  label       String // Campaign / display name
  type        AdType     @default(CUSTOM) // Google or Custom
  position    AdPosition // Where it appears on site
  targetUrl   String? // Click-through URL
  imageUrl    String?    @db.Text // Banner image URL (custom ads)
  impressions Int        @default(0)
  clicks      Int        @default(0)
  isActive    Boolean    @default(true)
  notes       String?    @db.Text // Internal admin notes
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
  @@index([position])
}

// ────────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────────

enum UserRole {
  ASPIRANT
  ADMIN
}

enum Category {
  TPSC
  SSC
  UPSC
  RAILWAY
  BANKING
  TEACHING
  POLICE
  DEFENCE
  STATE_PSC
  PRIVATE
  OTHER
}

enum Stage {
  NOTIFICATION // Notification released, dates TBA
  APPLICATION_OPEN // Application window open
  APPLICATION_CLOSED // Application window closed
  ADMIT_CARD // Admit cards available for download
  EXAM_SCHEDULED // Exam is upcoming / in progress
  RESULT_DECLARED // Result published
}

enum AdType {
  GOOGLE // Google AdSense / Ad Manager
  CUSTOM // Direct custom banner
}

enum AdPosition {
  HEADER_TOP // Leaderboard at top of page
  INLINE_AFTER_3RD // Inside job list after 3rd result
  SIDEBAR_STICKY // Right sidebar sticky unit
  FOOTER_BANNER // Bottom of page
  JOB_DETAIL_TOP // Top of job detail view
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Key-value store for site-wide settings (one row per unique key)
model SiteSettings {
  key       String   @id // e.g. "subscriptionPopup", "popupDelay", "fabEnabled", "portalName"
  value     String
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────
// MOCK TEST RESULTS
// ────────────────────────────────────────────────

model MockTestResult {
  id        String   @id @default(cuid())
  userId    String
  date      String // "YYYY-MM-DD" — the day the test was taken
  subject   String // "math" | "reasoning" | "english" | "gk" | "pyq"
  score     Int // correct answers
  wrong     Int // wrong answers
  skip      Int // skipped questions
  max       Int // total questions attempted
  timeSecs  Int      @default(0) // seconds taken
  mode      String   @default("timed") // "timed" | "practice"
  plan      String   @default("free") // "free" | "premium"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, subject]) // one result per user per subject per day
  @@index([userId])
  @@index([date])
}

// ────────────────────────────────────────────────
// UPGRADE REQUESTS
// ────────────────────────────────────────────────

model UpgradeRequest {
  id            String   @id @default(cuid())
  userId        String
  planId        String // "3m", "6m", "12m"
  screenshotUrl String   @db.Text
  status        String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ────────────────────────────────────────────────
// QUESTION HISTORY (Unique question delivery)
// ────────────────────────────────────────────────

// Tracks which questions a user has already seen per subject.
// seenHashes is a JSON array of question-text hashes (SHA-like fingerprints).
// When pool is nearly exhausted (< 10% left), this record is reset so
// questions recycle — ensuring the user always gets a fresh batch.
model UserQuestionHistory {
  id         String   @id @default(cuid())
  userId     String
  subject    String   // "math" | "reasoning" | "english" | "gk" | "pyq"
  seenHashes String   @db.Text @default("[]") // JSON array of question fingerprints
  totalSeen  Int      @default(0) // cumulative count
  updatedAt  DateTime @updatedAt

  @@unique([userId, subject])
  @@index([userId])
}

